# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here

# OpenAI specific
# LLM_BASE_URL=https://api.openai.com/v1

# Agent Configuration
MAX_ITERATIONS=10
LOG_LEVEL=INFO

# MCP Server Configuration
MCP_SERVER_COUNT=2

# Example: Filesystem MCP Server
MCP_SERVER_0_NAME=filesystem
MCP_SERVER_0_COMMAND=npx @modelcontextprotocol/server-filesystem /path/to/directory
MCP_SERVER_0_DESCRIPTION=File system access and manipulation

# Example: Web Search MCP Server
MCP_SERVER_1_NAME=brave_search
MCP_SERVER_1_COMMAND=npx @modelcontextprotocol/server-brave-search
MCP_SERVER_1_DESCRIPTION=Web search capabilities

# API Keys for different providers (uncomment as needed)
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key
# GOOGLE_API_KEY=your-google-key
# GROQ_API_KEY=your-groq-key
# OPENROUTER_API_KEY=your-openrouter-key